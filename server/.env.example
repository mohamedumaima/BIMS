# Server Runtime
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cloud PostgreSQL (Supabase — Recommended: Transaction Pooler :6543 for DATABASE_URL & Session Pooler :5432 for DIRECT_URL)
# Supabase Dashboard -> Connect -> ORMs -> Prisma:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-SUPABASE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-SUPABASE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# JWT Auth
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
JWT_EXPIRES_IN=8h

# Gemini AI Chatbot (Paste your Gemini API Key here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Cloudinary Media & Document Storage (Images, PDFs, Cheques, Bills, Receipts, Invoices)
# Cloudinary Console -> Settings -> API Keys:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ceylon-spices/products
CLOUDINARY_DOCUMENTS_FOLDER=ceylon-spices/documents

# Optional Supabase Storage fallback (leave blank when using Cloudinary)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-documents
