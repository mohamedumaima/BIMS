# Server Runtime
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (Local Dev: use your local import_export_db; Cloud: Supabase pooled & direct URLs)
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/import_export_db?schema=public
DIRECT_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/import_export_db?schema=public

# JWT Auth
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
JWT_EXPIRES_IN=8h

# Gemini AI Chatbot (Paste your Gemini API Key here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase Storage (required in production / Vercel for file & PDF persistence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-documents
